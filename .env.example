# TempMail Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED - PostgreSQL Connection (local Docker defaults)
# ============================================
# Start with: docker compose -f docker-compose.local.yml up -d --wait
# For hosted PostgreSQL, replace these values and set DB_SSLMODE=require.
DB_HOST=127.0.0.1
DB_USER=tempmail
DB_PASSWORD=tempmail_local
DB_NAME=tempmail
DB_PORT=5432
DB_SSLMODE=disable

# ============================================
# OPTIONAL - Application Settings
# ============================================

# Mail domain for SMTP (default: xelio.me)
MAIL_DOMAIN=xelio.me

# SMTP port to bind (default: 25)
# For local dev, use 1025 to avoid port permission issues
SMTP_PORT=1025

# SMTP in-process JSON metrics listener (default: 9100)
SMTP_METRICS_PORT=9100

# HTTP port (default: 3000)
HTTP_PORT=3000

# Optional admin secret for GET /api/emails (list all) and GET /api/admin/registry
# If unset, those routes return 401. Mailbox reads use X-Mailbox-Token from create.
ADMIN_TOKEN=

# Optional password for the server-rendered admin panel at /admin-panel.
# If unset or empty, every panel route returns 503. Sessions last 12h.
ADMIN_PANEL_PASSWORD=

# Optional geo provider for the request inspector (GET /admin).
# Uses ip-api.com batch lookups for IP -> country/city/ASN. Set empty to disable.
GEO_API_URL=http://ip-api.com

# ---------------------------------------------------------------------------
# Abuse protection
# ---------------------------------------------------------------------------

# Cloudflare Turnstile on POST /api/emails.
# false (default) leaves the API exactly as it was. Flip to true only after the
# frontend ships the widget, otherwise every creation returns 403.
# Verification fails closed: a Cloudflare outage returns 503, so this flag is
# also the kill switch.
TURNSTILE_ENABLED=false
# Public site key, also embedded in the frontend widget.
TURNSTILE_SITE_KEY=
# Server-only secret. Never ship this to the browser.
TURNSTILE_SECRET_KEY=
# Widget action to require. Leave empty to skip the action check (dev only).
TURNSTILE_EXPECTED_ACTION=create
# Hostnames Cloudflare may report. Comma-separated; empty disables the check.
TURNSTILE_REQUIRED_HOSTNAMES=xelio.me,www.xelio.me
# Override only for tests.
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Threshold alerts. One webhook, Slack and Discord compatible (posts both
# `text` and `content`). Unset disables alerting entirely.
ALERT_WEBHOOK_URL=
ALERT_CREATES_PER_MIN=60
ALERT_REJECTIONS_PER_MIN=120
ALERT_MAILS_PER_MIN=60
ALERT_429_PER_MIN=30
ALERT_COOLDOWN_SECS=1800
PANEL_URL=https://api.xelio.me/admin-panel

# Durable creation forensics: rows in access_events, cleaned up by the
# minute scheduler. Clamped to 1-90 days.
FORENSICS_RETENTION_DAYS=7

# SMTP message size cap in bytes. Default 2 MiB; accepted range 64 KiB - 25 MiB.
MAX_EMAIL_SIZE_BYTES=2097152
